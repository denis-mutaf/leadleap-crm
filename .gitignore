/design/
/docs/requirements/
/docs/integrations/
/scripts/amo-dump.py
/scripts/seed-demo.ts
/scripts/sync-ui.sh
/src/app/globals.css.bak-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
